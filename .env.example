# CalorieFlow AI — Environment Variables
# Copy to .env (or set in Lovable Cloud / Cloudflare Workers secrets).
# NEVER commit real values. All secrets must be in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE  (Project: Settings → API)
# ─────────────────────────────────────────────────────────────────────────────
# Browser-visible (safe to expose — used by the JS client):
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
VITE_SUPABASE_PROJECT_ID=xxxx

# Server-only — read inside createServerFn, never sent to browser:
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...     # Project → Settings → API → service_role

# ─────────────────────────────────────────────────────────────────────────────
# AI GATEWAY  (Lovable Cloud)
# ─────────────────────────────────────────────────────────────────────────────
# Powers: food image scan, voice meal parsing, AI coach chat.
# Get from: https://lovable.dev → Project → Settings → AI Gateway
LOVABLE_API_KEY=lv_...

# ─────────────────────────────────────────────────────────────────────────────
# SUBSCRIPTIONS  (choose one)
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: Stripe ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...         # Stripe CLI: stripe listen --forward-to ...
STRIPE_PRICE_ID_MONTHLY=price_...       # Monthly premium price ID
STRIPE_PRICE_ID_YEARLY=price_...        # Yearly premium price ID

# --- Option B: RevenueCat (mobile) ---
# dashboard.revenuecat.com → Project → API Keys
REVENUECAT_API_KEY=sk_...
REVENUECAT_WEBHOOK_SECRET=...

# ─────────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS  (optional — for workout reminders)
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Cloud Messaging (Android + Web)
# Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=AAAA...
VITE_FCM_VAPID_KEY=BN...               # Web Push VAPID public key

# Apple Push Notification Service (iOS — if building native)
# Apple Developer → Certificates → APNs Key
APNS_KEY_ID=ABC123...
APNS_TEAM_ID=DEF456...
# APNS_PRIVATE_KEY = contents of the .p8 file (base64 or multiline)

# ─────────────────────────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_URL=https://app.calorieflow.ai   # Used in OAuth redirects and emails
